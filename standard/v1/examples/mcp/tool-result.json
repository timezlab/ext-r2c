{
  "title": "A tool result with the reply, files, a live page and usage",
  "description": "Artifacts are content blocks with the R2C metadata in each block's `_meta`: the reply is `text` with `response: true` (MCP does not stream it), a file by `resource_link`, a file embedded as `resource`, and a live page by `resource_link`. Usage sits in the result's `_meta`.",
  "binding": "mcp",
  "rules": ["R2C-MCP-7", "R2C-MCP-8", "R2C-ARTIFACT-1", "R2C-ARTIFACT-2", "R2C-USAGE-1", "R2C-CORE-3"],
  "steps": [
    {
      "from": "remote",
      "type": "result",
      "method": "tools/call",
      "body": {
        "jsonrpc": "2.0", "id": 1,
        "result": {
          "resultType": "complete",
          "content": [
            {
              "type": "text",
              "text": "The October report is ready: 412 items, 3 below their reorder level.",
              "_meta": { "io.github.timezlab/r2c": { "kind": "artifact", "presentation": "inline", "response": true } }
            },
            {
              "type": "resource_link",
              "uri": "https://files.example.com/r/inventory-2026-10.csv",
              "name": "inventory-2026-10.csv",
              "mimeType": "text/csv",
              "_meta": { "io.github.timezlab/r2c": { "kind": "artifact", "presentation": "file" } }
            },
            {
              "type": "resource",
              "resource": { "uri": "urn:r2c:artifact:below-threshold", "mimeType": "text/plain", "text": "A-113 12\nB-201 8\nC-047 19\n" },
              "_meta": { "io.github.timezlab/r2c": { "kind": "artifact", "presentation": "file" } }
            },
            {
              "type": "resource_link",
              "uri": "https://remote.example.com/live/report-2026-10",
              "name": "Stock dashboard",
              "mimeType": "text/html",
              "_meta": { "io.github.timezlab/r2c": { "kind": "artifact", "presentation": "live" } }
            }
          ],
          "_meta": {
            "io.github.timezlab/r2c": {
              "kind": "usage", "input_tokens": 5200, "output_tokens": 940, "duration_ms": 9800,
              "cost": { "amount": 0.031, "currency": "EUR" }, "model": "example-model-1"
            }
          }
        }
      }
    }
  ]
}

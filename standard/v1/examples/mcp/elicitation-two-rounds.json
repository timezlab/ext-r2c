{
  "title": "Two questions one after the other in one tool call, with the usage so far beside the second",
  "description": "A tool call has at most one pending request, so a second question comes in a second round, after the first has its response. Each round has a new `requestState`. The second input-required result carries the usage so far beside `input_requests`; the final result carries the total. Derived answers: {kind: answer, id: q-1, outcome: answered, answered_by: {role: person}, value: {title: October stock}}, then {kind: answer, id: q-2, outcome: answered, answered_by: {role: person}, value: {warehouse: North}}.",
  "binding": "mcp",
  "rules": ["R2C-MCP-1", "R2C-MCP-4", "R2C-MCP-8", "R2C-ASK-3"],
  "steps": [
    {
      "from": "client",
      "type": "request",
      "body": {
        "jsonrpc": "2.0", "id": 1, "method": "tools/call",
        "params": {
          "name": "monthly_report",
          "arguments": { "month": "2026-10" },
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientCapabilities": { "elicitation": { "form": {} }, "extensions": { "io.github.timezlab/r2c": {} } }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "result",
      "method": "tools/call",
      "body": {
        "jsonrpc": "2.0", "id": 1,
        "result": {
          "resultType": "input_required",
          "inputRequests": {
            "q-1": {
              "method": "elicitation/create",
              "params": {
                "mode": "form",
                "message": "Report title",
                "requestedSchema": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string", "title": "Title", "description": "What is the report's title?" }
                  },
                  "required": ["title"]
                }
              }
            }
          },
          "requestState": "eyJzdGF0ZSI6InR3by1yb3VuZHMtMSJ9",
          "_meta": {
            "io.github.timezlab/r2c": {
              "input_requests": {
                "q-1": {
                  "kind": "question", "id": "q-1", "title": "Report title", "answer_by": { "role": "person" },
                  "fields": [{ "key": "title", "header": "Title", "text": "What is the report's title?", "type": "text" }]
                }
              }
            }
          }
        }
      }
    },
    {
      "from": "client",
      "type": "request",
      "body": {
        "jsonrpc": "2.0", "id": 2, "method": "tools/call",
        "params": {
          "name": "monthly_report",
          "arguments": { "month": "2026-10" },
          "inputResponses": { "q-1": { "action": "accept", "content": { "title": "October stock" } } },
          "requestState": "eyJzdGF0ZSI6InR3by1yb3VuZHMtMSJ9",
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientCapabilities": { "elicitation": { "form": {} }, "extensions": { "io.github.timezlab/r2c": {} } }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "result",
      "method": "tools/call",
      "body": {
        "jsonrpc": "2.0", "id": 2,
        "result": {
          "resultType": "input_required",
          "inputRequests": {
            "q-2": {
              "method": "elicitation/create",
              "params": {
                "mode": "form",
                "message": "Warehouse",
                "requestedSchema": {
                  "type": "object",
                  "properties": {
                    "warehouse": {
                      "type": "string", "title": "Warehouse", "description": "Which warehouse should the report cover?",
                      "oneOf": [{ "const": "North", "title": "North" }, { "const": "South", "title": "South" }]
                    }
                  },
                  "required": ["warehouse"]
                }
              }
            }
          },
          "requestState": "eyJzdGF0ZSI6InR3by1yb3VuZHMtMiJ9",
          "_meta": {
            "io.github.timezlab/r2c": {
              "input_requests": {
                "q-2": {
                  "kind": "question", "id": "q-2", "title": "Warehouse", "answer_by": { "role": "person" },
                  "fields": [
                    {
                      "key": "warehouse", "header": "Warehouse", "text": "Which warehouse should the report cover?",
                      "type": "one", "other": false, "options": [{ "label": "North" }, { "label": "South" }]
                    }
                  ]
                }
              },
              "usage": { "kind": "usage", "input_tokens": 1800, "output_tokens": 120 }
            }
          }
        }
      }
    },
    {
      "from": "client",
      "type": "request",
      "body": {
        "jsonrpc": "2.0", "id": 3, "method": "tools/call",
        "params": {
          "name": "monthly_report",
          "arguments": { "month": "2026-10" },
          "inputResponses": { "q-2": { "action": "accept", "content": { "warehouse": "North" } } },
          "requestState": "eyJzdGF0ZSI6InR3by1yb3VuZHMtMiJ9",
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientCapabilities": { "elicitation": { "form": {} }, "extensions": { "io.github.timezlab/r2c": {} } }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "result",
      "method": "tools/call",
      "body": {
        "jsonrpc": "2.0", "id": 3,
        "result": {
          "resultType": "complete",
          "content": [
            {
              "type": "text", "text": "October stock for North is ready: 207 items, 2 below their reorder level.",
              "_meta": { "io.github.timezlab/r2c": { "kind": "artifact", "presentation": "inline", "response": true } }
            }
          ],
          "_meta": { "io.github.timezlab/r2c": { "kind": "usage", "input_tokens": 3400, "output_tokens": 610 } }
        }
      }
    }
  ]
}

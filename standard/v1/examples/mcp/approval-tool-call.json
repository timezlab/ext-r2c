        "result": {
          "resultType": "input_required",
          "inputRequests": {
            "ap-1": {
              "method": "elicitation/create",
              "params": {
                "mode": "form",
                "message": "Run publish_page",
                "requestedSchema": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "type": "string", "title": "Decision",
                      "oneOf": [{ "const": "allow", "title": "Allow" }, { "const": "edit", "title": "Edit" }, { "const": "deny", "title": "Deny" }]
                    },
                    "reason": { "type": "string", "title": "Reason" },
                    "page": { "type": "string", "title": "page", "default": "team/reports" }
                  },
                  "required": ["decision"]
                }
              }
            }
          },
          "requestState": "eyJzdGF0ZSI6ImFwcHJvdmUtMSJ9",
          "_meta": {
            "io.github.timezlab/r2c": {
              "input_requests": {
                "ap-1": {
                  "kind": "approval", "id": "ap-1", "title": "Run publish_page", "answer_by": { "role": "person" },
                  "subject": {
                    "type": "tool_call",
                    "name": "publish_page",
                    "args": { "page": "team/reports" },
                    "args_schema": {
                      "type": "object",
                      "properties": { "page": { "type": "string", "title": "Page" } },
                      "required": ["page"],
                      "additionalProperties": false
                    }
                  },
                  "decisions": ["allow", "edit", "deny"]
                }
              }
            }
          }
        }
      }
    },
    {
      "from": "client",
      "type": "request",
      "body": {
        "jsonrpc": "2.0", "id": 2, "method": "tools/call",
        "params": {
          "name": "publish_page",
          "arguments": { "page": "team/reports" },
          "inputResponses": { "ap-1": { "action": "accept", "content": { "decision": "deny", "reason": "The page is not reviewed yet." } } },
          "requestState": "eyJzdGF0ZSI6ImFwcHJvdmUtMSJ9",
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientCapabilities": { "elicitation": { "form": {} }, "extensions": { "io.github.timezlab/r2c": {} } }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "result",
      "method": "tools/call",
      "body": {
        "jsonrpc": "2.0", "id": 2,
        "result": {

{
  "title": "A full streamed run: activities, reply chunks, a file, an approval, usage",
  "description": "One task from activation to completion. The reply is one inline artifact with `response: true`, streamed in three chunks (append false, then true, then true with lastChunk) and interleaved with the activities in the order they happen. A file artifact comes in the middle, an approval stops the task at input-required, the client allows it, and the terminal status carries the usage.",
  "binding": "a2a",
  "rules": [
    "R2C-ACT-2", "R2C-ARTIFACT-1", "R2C-ARTIFACT-2", "R2C-ARTIFACT-3", "R2C-ARTIFACT-4",
    "R2C-ACTIVITY-1", "R2C-ACTIVITY-2", "R2C-ACTIVITY-3", "R2C-APPROVAL-1", "R2C-ANSWER-1", "R2C-ANSWER-2",
    "R2C-USAGE-1", "R2C-A2A-1", "R2C-A2A-2", "R2C-A2A-3", "R2C-A2A-4", "R2C-A2A-5",
    "R2C-CORE-1", "R2C-CORE-2", "R2C-CORE-4"
  ],
  "steps": [
    {
      "from": "client",
      "type": "SendMessageRequest",
      "headers": { "A2A-Extensions": "https://github.com/timezlab/ext-r2c/tree/main/standard/v1" },
      "body": {
        "message": {
          "messageId": "msg-c1", "role": "ROLE_USER",
          "parts": [{ "text": "Build the October inventory report and publish it to the team page." }]
        },
        "configuration": { "acceptedOutputModes": ["text/plain", "text/csv"] }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "headers": { "A2A-Extensions": "https://github.com/timezlab/ext-r2c/tree/main/standard/v1" },
      "body": { "task": { "id": "task-1", "contextId": "ctx-1", "status": { "state": "TASK_STATE_SUBMITTED" } } }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r1", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Building the October report" },
                {
                  "data": { "kind": "activity", "id": "step-1", "type": "step", "state": "running", "label": "Building the October report" },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "artifactUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "artifact": {
            "artifactId": "art-reply",
            "parts": [{ "text": "I'll read the inventory first. " }],
            "metadata": {
              "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": { "kind": "artifact", "presentation": "inline", "response": true }
            }
          },
          "append": false
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r2", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Reading the inventory" },
                {
                  "data": {
                    "kind": "activity", "id": "call-1", "type": "tool", "state": "running", "name": "read_inventory",
                    "label": "Reading the inventory", "parent_id": "step-1"
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r3", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Read the inventory: 412 items" },
                {
                  "data": {
                    "kind": "activity", "id": "call-1", "type": "tool", "state": "done", "name": "read_inventory",
                    "label": "Read the inventory", "parent_id": "step-1", "detail": "412 items", "duration_ms": 840
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "artifactUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "artifact": {
            "artifactId": "art-reply",
            "parts": [{ "text": "412 items read; 3 are below their reorder level. " }],
            "metadata": {
              "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": { "kind": "artifact", "presentation": "inline", "response": true }
            }
          },
          "append": true
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "artifactUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "artifact": {
            "artifactId": "art-file-1",
            "name": "inventory-2026-10.csv",
            "parts": [{ "url": "https://files.example.com/r/inventory-2026-10.csv", "filename": "inventory-2026-10.csv", "mediaType": "text/csv" }],
            "metadata": {
              "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": { "kind": "artifact", "presentation": "file" }
            }
          },
          "lastChunk": true
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_INPUT_REQUIRED",
            "message": {
              "messageId": "msg-r4", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Publish inventory-2026-10.csv to the team page? allow | deny" },
                {
                  "data": {
                    "kind": "approval", "id": "ap-1", "title": "Publish inventory-2026-10.csv to the team page",
                    "answer_by": { "role": "person" },
                    "subject": { "type": "tool_call", "name": "publish_page", "args": { "page": "team/reports", "file": "inventory-2026-10.csv" } },
                    "decisions": ["allow", "deny"]
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "client",
      "type": "SendMessageRequest",
      "headers": { "A2A-Extensions": "https://github.com/timezlab/ext-r2c/tree/main/standard/v1" },
      "body": {
        "message": {
          "messageId": "msg-c2", "role": "ROLE_USER", "taskId": "task-1", "contextId": "ctx-1",
          "parts": [
            { "text": "Allow" },
            {
              "data": { "kind": "answer", "id": "ap-1", "outcome": "answered", "answered_by": { "role": "person" }, "value": { "decision": "allow" } },
              "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
            }
          ]
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "headers": { "A2A-Extensions": "https://github.com/timezlab/ext-r2c/tree/main/standard/v1" },
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r5", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Publishing to the team page" },
                {
                  "data": {
                    "kind": "activity", "id": "call-2", "type": "tool", "state": "running", "name": "publish_page",
                    "label": "Publishing to the team page", "parent_id": "step-1"
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r6", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Published to the team page" },
                {
                  "data": {
                    "kind": "activity", "id": "call-2", "type": "tool", "state": "done", "name": "publish_page",
                    "label": "Published to the team page", "parent_id": "step-1", "duration_ms": 450
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "artifactUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "artifact": {
            "artifactId": "art-reply",
            "parts": [{ "text": "The report is published on the team page." }],
            "metadata": {
              "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": { "kind": "artifact", "presentation": "inline", "response": true }
            }
          },
          "append": true,
          "lastChunk": true
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r7", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Built the October report" },
                {
                  "data": { "kind": "activity", "id": "step-1", "type": "step", "state": "done", "label": "Built the October report", "duration_ms": 6100 },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_COMPLETED",
            "message": {
              "messageId": "msg-r8", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Done: 5,200 input and 940 output tokens, 9.8 s." },
                {
                  "data": {
                    "kind": "usage", "input_tokens": 5200, "output_tokens": 940, "duration_ms": 9800,
                    "cost": { "amount": 0.031, "currency": "EUR" }, "model": "example-model-1"
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    }
  ]
}

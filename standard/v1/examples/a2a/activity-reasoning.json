{
  "title": "Reasoning, turned on by the remote's owner, in coalesced deltas",
  "description": "Each `delta` is appended to the reasoning with the same `id`. Deltas are readable pieces, not single tokens. No provider signature or encrypted reasoning is sent.",
  "binding": "a2a",
  "rules": ["R2C-ACTIVITY-4", "R2C-ACTIVITY-7", "R2C-A2A-3"],
  "steps": [

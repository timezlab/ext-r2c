      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r1", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Thinking" },
                {
                  "data": { "kind": "activity", "id": "rs-1", "type": "reasoning", "label": "Thinking", "delta": "Three items are below the threshold. " },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    },
    {
      "from": "remote",
      "type": "StreamResponse",
      "body": {
        "statusUpdate": {
          "taskId": "task-1", "contextId": "ctx-1",
          "status": {
            "state": "TASK_STATE_WORKING",
            "message": {
              "messageId": "msg-r2", "role": "ROLE_AGENT",
              "parts": [
                { "text": "Thinking" },
                {
                  "data": {
                    "kind": "activity", "id": "rs-1", "type": "reasoning", "label": "Thinking",
                    "delta": "A-113 has an open order already, so only B-201 and C-047 need a reorder."
                  },
                  "metadata": { "https://github.com/timezlab/ext-r2c/tree/main/standard/v1": {} }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
